{
  "name": "gxnu-lu-guangquan-profile",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/teacher-profile.js --bundle --minify --format=iife --target=es2020 --loader:.csl=text --loader:.xml=text --alias:node-fetch=./src/shims/node-fetch.js --alias:sync-fetch=./src/shims/sync-fetch.js --outfile=dist/assets/teacher-profile.js",
    "build:content": "node scripts/build.mjs",
    "build": "npm run bundle && npm run build:content",
    "verify": "npm run build && node scripts/validate.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@citation-js/plugin-csl": "0.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
